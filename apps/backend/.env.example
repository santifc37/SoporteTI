
# Supabase - Connect - Session pooler
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_CONTRASENA@aws-0-TU_REGION.pooler.supabase.com:5432/postgres

# SOLO para pruebas locales mientras no exista el login (RF-01).
# Con "true" se acepta el encabezado X-Dev-User-Id. Nunca activar fuera de local.
DEV_AUTH_ENABLED=false

# Direcciones permitidas del frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

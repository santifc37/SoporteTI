
# Supabase - Connect - Session pooler
DATABASE_URL=postgresql://postgres.TU_PROJECT_REF:TU_CONTRASENA@aws-0-TU_REGION.pooler.supabase.com:5432/postgres

# Sesiones (cookie HttpOnly). En producción: SESSION_COOKIE_SECURE=true.
SESSION_DURATION_HOURS=8
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Direcciones permitidas del frontend
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

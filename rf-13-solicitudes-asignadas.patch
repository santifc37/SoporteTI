+import uuid
+from datetime import datetime
+from typing import Literal
+
+from pydantic import BaseModel
+
+from app.schemas.pagination import Pagination
+
+# Valores controlados (docs/contrato-api.md §8 y MER.md).
+EstadoSolicitud = Literal[
+    "registrado",
+    "en_evaluacion",
+    "asignado",
+    "en_atencion",
+    "en_espera",
+    "resuelto",
+    "cerrado",
+]
+PrioridadSolicitud = Literal["baja", "media", "alta"]
+TipoSolicitud = Literal["incidente", "requerimiento"]
+
+
+class CategoriaResumen(BaseModel):
+    id: uuid.UUID
+    nombre: str
+
+
+class UsuarioResumen(BaseModel):
+    id: uuid.UUID
+    nombre: str
+
+
+class SolicitudResumen(BaseModel):
+    """Elemento de `GET /api/v1/requests` (docs/contrato-api.md §7.1)."""
+
+    id: uuid.UUID
+    numero: str
+    titulo: str
+    tipo: TipoSolicitud
+    prioridad: PrioridadSolicitud | None
+    estado: EstadoSolicitud
+    categoria: CategoriaResumen | None
+    solicitante: UsuarioResumen
+    tecnico_asignado: UsuarioResumen | None
+    fecha_creacion: datetime
+
+
+class SolicitudesPagina(BaseModel):
+    data: list[SolicitudResumen]
+    pagination: Pagination
diff --git a/apps/backend/app/services/solicitudes.py b/apps/backend/app/services/solicitudes.py
new file mode 100644
index 0000000..049882b
--- /dev/null
+++ b/apps/backend/app/services/solicitudes.py
@@ -0,0 +1,128 @@
+import uuid
+from dataclasses import dataclass
+from datetime import datetime
+
+from sqlalchemy import func, or_, select
+from sqlalchemy.orm import Session, aliased
+
+from app.models import Asignacion, Categoria, Solicitud, Usuario
+from app.schemas.pagination import Pagination, calcular_total_paginas
+from app.schemas.solicitud import (
+    CategoriaResumen,
+    SolicitudesPagina,
+    SolicitudResumen,
+    UsuarioResumen,
+)
+
+
+@dataclass(frozen=True)
+class FiltrosSolicitudes:
+    """Filtros opcionales de docs/contrato-api.md §7.1 que aplican al técnico.
+
+    `tecnico_id` y `solicitante_id` no existen a propósito: los filtros no
+    pueden ampliar los permisos del usuario (contrato §17).
+    """
+
+    estado: str | None = None
+    prioridad: str | None = None
+    categoria_id: uuid.UUID | None = None
+    tipo: str | None = None
+    busqueda: str | None = None
+    fecha_desde: datetime | None = None
+    fecha_hasta: datetime | None = None
+
+
+def _condiciones(tecnico_id: uuid.UUID, filtros: FiltrosSolicitudes) -> list:
+    """Condiciones WHERE: asignación activa del técnico + filtros opcionales."""
+    condiciones = [
+        Asignacion.tecnico_id == tecnico_id,
+        Asignacion.fecha_finalizacion.is_(None),
+    ]
+    if filtros.estado:
+        condiciones.append(Solicitud.estado == filtros.estado)
+    if filtros.prioridad:
+        condiciones.append(Solicitud.prioridad == filtros.prioridad)
+    if filtros.categoria_id:
+        condiciones.append(Solicitud.categoria_id == filtros.categoria_id)
+    if filtros.tipo:
+        condiciones.append(Solicitud.tipo == filtros.tipo)
+    if filtros.busqueda:
+        patron = f"%{filtros.busqueda.strip()}%"
+        condiciones.append(
+            or_(Solicitud.numero.ilike(patron), Solicitud.titulo.ilike(patron))
+        )
+    if filtros.fecha_desde:
+        condiciones.append(Solicitud.fecha_creacion >= filtros.fecha_desde)
+    if filtros.fecha_hasta:
+        condiciones.append(Solicitud.fecha_creacion <= filtros.fecha_hasta)
+    return condiciones
+
+
+def _nombre_completo(usuario: Usuario) -> str:
+    return f"{usuario.nombre} {usuario.apellido}".strip()
+
+
+def listar_solicitudes_asignadas(
+    db: Session,
+    tecnico_id: uuid.UUID,
+    filtros: FiltrosSolicitudes,
+    page: int,
+    limit: int,
+) -> SolicitudesPagina:
+    """RF-13: solicitudes asignadas actualmente al técnico (RN-05).
+
+    Una solicitud pertenece al técnico mientras su asignación esté activa
+    (`fecha_finalizacion IS NULL`). Tras una reasignación el técnico anterior
+    deja de verla (RN-14). Las solicitudes cerradas siguen visibles porque
+    son de solo consulta (RN-23); se pueden excluir con el filtro `estado`.
+    """
+    condiciones = _condiciones(tecnico_id, filtros)
+
+    total = db.scalar(
+        select(func.count(Solicitud.id))
+        .join(Asignacion, Asignacion.solicitud_id == Solicitud.id)
+        .where(*condiciones)
+    )
+
+    solicitante = aliased(Usuario)
+    tecnico = aliased(Usuario)
+    filas = db.execute(
+        select(Solicitud, solicitante, Categoria, tecnico)
+        .join(Asignacion, Asignacion.solicitud_id == Solicitud.id)
+        .join(tecnico, tecnico.id == Asignacion.tecnico_id)
+        .join(solicitante, solicitante.id == Solicitud.solicitante_id)
+        .outerjoin(Categoria, Categoria.id == Solicitud.categoria_id)
+        .where(*condiciones)
+        # Orden estable: el desempate por id evita repetidos entre páginas.
+        .order_by(Solicitud.fecha_creacion.desc(), Solicitud.id.desc())
+        .offset((page - 1) * limit)
+        .limit(limit)
+    ).all()
+
+    data = [
+        SolicitudResumen(
+            id=sol.id,
+            numero=sol.numero,
+            titulo=sol.titulo,
+            tipo=sol.tipo,
+            prioridad=sol.prioridad,
+            estado=sol.estado,
+            categoria=(
+                CategoriaResumen(id=cat.id, nombre=cat.nombre) if cat else None
+            ),
+            solicitante=UsuarioResumen(id=sol_user.id, nombre=_nombre_completo(sol_user)),
+            tecnico_asignado=UsuarioResumen(id=tec.id, nombre=_nombre_completo(tec)),
+            fecha_creacion=sol.fecha_creacion,
+        )
+        for sol, sol_user, cat, tec in filas
+    ]
+
+    return SolicitudesPagina(
+        data=data,
+        pagination=Pagination(
+            page=page,
+            limit=limit,
+            total=total,
+            total_pages=calcular_total_paginas(total, limit),
+        ),
+    )
diff --git a/apps/backend/tests/test_rf13_solicitudes_asignadas.py b/apps/backend/tests/test_rf13_solicitudes_asignadas.py
new file mode 100644
index 0000000..43b2118
--- /dev/null
+++ b/apps/backend/tests/test_rf13_solicitudes_asignadas.py
@@ -0,0 +1,338 @@
+"""Pruebas de RF-13: consulta de solicitudes asignadas al técnico.
+
+Usan SQLite en memoria (no tocan Supabase). El filtrado por asignación activa
+se prueba con datos reales. En la mayoría de pruebas la sesión se simula con
+`como()`; una prueba usa el login real (RF-01) de punta a punta.
+"""
+
+import itertools
+import uuid
+from datetime import datetime, timedelta
+
+import pytest
+from fastapi.testclient import TestClient
+from sqlalchemy import create_engine
+from sqlalchemy.orm import Session
+from sqlalchemy.pool import StaticPool
+
+from app.api.dependencies import UsuarioActual, get_current_user
+from app.core.security import hash_password
+from app.database.session import get_db
+from app.main import app
+from app.models import Asignacion, Base, Categoria, Solicitud, Usuario
+
+URL = "/api/v1/requests"
+_contador = itertools.count(1)
+
+
+@pytest.fixture()
+def db():
+    engine = create_engine(
+        "sqlite://",
+        connect_args={"check_same_thread": False},
+        poolclass=StaticPool,
+    )
+    Base.metadata.create_all(engine)
+    with Session(engine) as session:
+        yield session
+    engine.dispose()
+
+
+@pytest.fixture()
+def client(db):
+    app.dependency_overrides[get_db] = lambda: db
+    yield TestClient(app)
+    app.dependency_overrides.clear()
+
+
+def como(usuario: Usuario):
+    """Simula la sesión del usuario indicado."""
+    app.dependency_overrides[get_current_user] = lambda: UsuarioActual(
+        id=usuario.id,
+        rol=usuario.rol,
+        nombre=usuario.nombre,
+        apellido=usuario.apellido,
+        correo=usuario.correo,
+        activo=True,
+        sesion_id=uuid.uuid4(),
+    )
+
+
+def crear_usuario(db, rol, nombre="Ana", apellido="Pérez", contrasena="x"):
+    usuario = Usuario(
+        nombre=nombre,
+        apellido=apellido,
+        correo=f"{uuid.uuid4()}@test.com",
+        password_hash=hash_password(contrasena),
+        rol=rol,
+    )
+    db.add(usuario)
+    db.commit()
+    return usuario
+
+
+def crear_solicitud(db, solicitante, tecnico=None, *, activa=True, **campos):
+    """Crea una solicitud y, si se indica técnico, su asignación."""
+    n = next(_contador)
+    datos = {
+        "numero": f"ST-{n:06d}",
+        "titulo": f"Solicitud {n}",
+        "descripcion": "Descripción",
+        "tipo": "incidente",
+        "solicitante_id": solicitante.id,
+        "ubicacion": "Oficina",
+        "medio_contacto": "correo",
+        "dato_contacto": "a@test.com",
+        "estado": "asignado",
+        "fecha_creacion": datetime(2026, 11, 1) + timedelta(minutes=n),
+    }
+    datos.update(campos)
+    solicitud = Solicitud(**datos)
+    db.add(solicitud)
+    db.commit()
+
+    if tecnico is not None:
+        db.add(
+            Asignacion(
+                solicitud_id=solicitud.id,
+                tecnico_id=tecnico.id,
+                asignado_por=tecnico.id,
+                fecha_finalizacion=None if activa else datetime(2026, 11, 2),
+            )
+        )
+        db.commit()
+    return solicitud
+
+
+@pytest.fixture()
+def escenario(db):
+    return {
+        "solicitante": crear_usuario(db, "solicitante", "Juan", "Pérez"),
+        "tecnico": crear_usuario(db, "tecnico", "Carlos", "Gómez"),
+        "otro_tecnico": crear_usuario(db, "tecnico", "Luis", "Díaz"),
+        "coordinador": crear_usuario(db, "coordinador"),
+    }
+
+
+def test_tecnico_ve_solo_sus_solicitudes_asignadas(client, db, escenario):
+    solicitante, tecnico, otro = (
+        escenario["solicitante"],
+        escenario["tecnico"],
+        escenario["otro_tecnico"],
+    )
+    propia = crear_solicitud(db, solicitante, tecnico)
+    crear_solicitud(db, solicitante, otro)  # de otro técnico
+    crear_solicitud(db, solicitante)  # sin asignar
+    como(tecnico)
+
+    respuesta = client.get(URL)
+
+    assert respuesta.status_code == 200
+    cuerpo = respuesta.json()
+    assert [s["id"] for s in cuerpo["data"]] == [str(propia.id)]
+    assert cuerpo["pagination"]["total"] == 1
+
+
+def test_reasignacion_quita_el_acceso_al_tecnico_anterior(client, db, escenario):
+    """RN-14: tras reasignar, la asignación anterior queda finalizada."""
+    solicitante, anterior, nuevo = (
+        escenario["solicitante"],
+        escenario["tecnico"],
+        escenario["otro_tecnico"],
+    )
+    solicitud = crear_solicitud(db, solicitante, anterior, activa=False)
+    db.add(
+        Asignacion(
+            solicitud_id=solicitud.id, tecnico_id=nuevo.id, asignado_por=nuevo.id
+        )
+    )
+    db.commit()
+
+    como(anterior)
+    assert client.get(URL).json()["data"] == []
+
+    como(nuevo)
+    assert [s["id"] for s in client.get(URL).json()["data"]] == [str(solicitud.id)]
+
+
+def test_respuesta_sigue_el_contrato(client, db, escenario):
+    categoria = Categoria(nombre="Hardware")
+    db.add(categoria)
+    db.commit()
+    crear_solicitud(
+        db,
+        escenario["solicitante"],
+        escenario["tecnico"],
+        categoria_id=categoria.id,
+        prioridad="alta",
+        estado="en_atencion",
